<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.doitio.callbridgehelper" android:versionCode="1" android:versionName="0.1">
    <uses-sdk android:minSdkVersion="31" android:targetSdkVersion="36" />
    <uses-permission android:name="android.permission.MANAGE_ONGOING_CALLS" />
    <application android:label="通话桥辅助" android:allowBackup="false" android:debuggable="false" android:usesCleartextTraffic="false">
        <service android:name=".BridgeInCallService" android:exported="true" android:permission="android.permission.BIND_INCALL_SERVICE">
            <intent-filter><action android:name="android.telecom.InCallService" /></intent-filter>
            <meta-data android:name="android.telecom.IN_CALL_SERVICE_UI" android:value="false" />
            <meta-data android:name="android.telecom.INCLUDE_SELF_MANAGED_CALLS" android:value="false" />
            <meta-data android:name="android.telecom.INCLUDE_EXTERNAL_CALLS" android:value="false" />
        </service>
    </application>
</manifest>
